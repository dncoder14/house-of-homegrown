PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/house-of-homegrown
# Use a long random value (32+ characters), e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Comma-separated list of allowed browser origins (required in production)
FRONTEND_URL=http://localhost:5173
